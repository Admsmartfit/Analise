# Modelo de .env para o deploy no SERVIDOR LINUX (docker-compose.server.yml).
# Copie para ".env" na mesma pasta do docker-compose.server.yml e preencha os valores reais.
# Este arquivo usa so texto simples (sem acento, sem travessao) de proposito, para
# evitar problema de codificacao de caracteres com o parser do docker compose.

# Banco de Dados PostgreSQL
# DB_HOST fica fixo em "db" (o docker-compose.server.yml sobrescreve de qualquer forma).
DB_HOST=db
DB_PORT=5432
DB_NAME=smartfit_db
DB_USER=postgres
DB_PASSWORD=escolha-uma-senha-forte-aqui

# IMAP (acesso ao e-mail via Senha de App do Gmail/Google Workspace)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seuemail@suaempresa.com
IMAP_APP_PASSWORD=suasenhadeapp16chr
IMAP_MAILBOX=INBOX

# Painel Flask (a porta 5030 no host e mapeada no docker-compose.server.yml, nao aqui)
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
FLASK_PORT=5000
FLASK_DEBUG=False

# Streamlit (modulo de Previsao de Cancelamento)
STREAMLIT_PORT=8501
# Deixe em branco para usar o padrao (so acessivel via tunel SSH/LAN no servidor).
# Se um dia publicar esse servico tambem via Cloudflare Tunnel, troque pela URL publica:
# STREAMLIT_URL=https://smartfit-ml.seudominio.com
STREAMLIT_URL=

# Metabase (Painel Analitico BI)
METABASE_PORT=3000
# Mesma logica do Streamlit acima.
# METABASE_URL=https://smartfit-bi.seudominio.com
METABASE_URL=

# Usadas so pelo script scripts/setup_metabase.py (configuracao inicial do Metabase,
# rodado uma vez apos o "docker compose up -d"). Nao precisam ficar no .env do app.
MB_ADMIN_EMAIL=seuemail@suaempresa.com
MB_ADMIN_PASSWORD=escolha-uma-senha-forte-para-o-metabase
MB_PG_PASSWORD=escolha-uma-senha-para-o-usuario-metabase_reader
