# Modelo de .env para o deploy no SERVIDOR LINUX (docker-compose.server.yml).
# Copie para ".env" na mesma pasta do docker-compose.server.yml e preencha os valores reais.

# Banco de Dados PostgreSQL — DB_HOST é sobrescrito para "db" pelo docker-compose.server.yml
# (nome do serviço Postgres dentro da rede interna do Docker); os outros valores aqui valem.
DB_HOST=db
DB_PORT=5432
DB_NAME=smartfit_db
DB_USER=postgres
DB_PASSWORD=escolha-uma-senha-forte-aqui

# IMAP (acesso ao e-mail via Senha de App do Gmail/Google Workspace)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seuemail@suaempresa.com
IMAP_APP_PASSWORD=suasenhadeapp16chr
IMAP_MAILBOX=INBOX

# Painel Flask (porta interna do container continua 5000; o mapeamento pra 5030
# no host é feito no docker-compose.server.yml, não aqui)
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
FLASK_PORT=5000
FLASK_DEBUG=False

# Streamlit (módulo de Previsão de Cancelamento)
STREAMLIT_PORT=8501
# Deixe em branco para usar o padrão (só acessível via túnel SSH/LAN no servidor).
# Se um dia publicar esse serviço também via Cloudflare Tunnel, troque para a URL pública:
# STREAMLIT_URL=https://smartfit-ml.seudominio.com
STREAMLIT_URL=

# Metabase (Painel Analítico BI)
METABASE_PORT=3000
# Mesma lógica do Streamlit acima.
# METABASE_URL=https://smartfit-bi.seudominio.com
METABASE_URL=

# Usadas só pelo script scripts/setup_metabase.py (configuração inicial do Metabase,
# rodado uma vez após o "docker compose up -d"). Não precisam ficar no .env do app.
MB_ADMIN_EMAIL=seuemail@suaempresa.com
MB_ADMIN_PASSWORD=escolha-uma-senha-forte-para-o-metabase
MB_PG_PASSWORD=escolha-uma-senha-para-o-usuario-metabase_reader
